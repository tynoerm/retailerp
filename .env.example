# Copy to .env.local for local development. On Vercel, add the same keys under
# Project → Settings → Environment Variables (never commit real values).

# MySQL / MariaDB. For a cPanel database use the server hostname or IP (NOT "localhost"),
# and the full prefixed names shown in cPanel → MySQL Databases, e.g. cpaneluser_dbname / cpaneluser_dbuser.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=retailerp
DB_USER=root
DB_PASSWORD=

# Optional
# DB_SSL=true                       # only if your MySQL server has SSL enabled
# DB_SSL_REJECT_UNAUTHORIZED=false  # self-signed certificate on the server
# DB_POOL_LIMIT=3                   # connections per server instance (default 3 on Vercel, 10 locally)
# DB_CONNECT_TIMEOUT=15000

# First administrator, created only when the users table is empty (required in production).
# ADMIN_EMAIL=admin@retailerp.local
# ADMIN_PASSWORD=
